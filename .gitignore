# MCP server config — install/operator-specific paths, regenerated
# per-run by sift_guard.cli using the running interpreter's
# sys.executable. Committing it would re-bake one operator's
# absolute paths into every other clone (the 2026-05-12 SRL v5
# incident: a dev-machine python path baked into the repo's
# .mcp.json overwrote /opt/sift-guard/.mcp.json on git reset and
# caused every analyst subagent to fall back to raw Bash).
.mcp.json

# Case data — NEVER commit evidence
case-data/
*.raw
*.mem
*.aff4
*.E01
*.vmem
*.dmp
*.pcap
*.pcapng

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets — paranoid catch-all
.env
.env.*
*.key
*.pem
secrets/

# RAG corpus + index (large, regenerable from rag/ingest_attack.py)
rag/data/

# Per-case generated logs and extractions under case-data/
# (regenerable, can be huge). Scoped so docs/execution-logs/audit/ —
# the redacted submission deliverable — is not silently excluded.
case-data/audit/
case-data/extractions/

# Claude Code local state
.claude/state/
.claude/transcripts/
.claude/settings.local.json
.claude/scheduled_tasks.lock
